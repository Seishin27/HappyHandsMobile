# ─────────────────────────────────────────────────────────────────────────────
# Happy Hands — environment template
# Copy this file to `.env` and fill in real values. Safe to commit.
# ─────────────────────────────────────────────────────────────────────────────

# ── Flask runtime ───────────────────────────────────────────────────────────
FLASK_APP=run.py
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5500
HH_DEBUG=1
HH_DISABLE_RELOADER=0

# Base URL the Flutter app uses to reach this server. Mirrors flutter_app/.env.
#   • Android emulator:               http://10.0.2.2:5500/api
#   • Physical phone (same Wi-Fi):    http://<your-PC-LAN-IP>:5500/api
#   • iOS simulator / desktop / web:  http://127.0.0.1:5500/api
API_BASE_URL=http://10.0.2.2:5500/api

# ── Database (MySQL) ────────────────────────────────────────────────────────
HH_DB_HOST=localhost
HH_DB_PORT=3306
HH_DB_USER=root
HH_DB_PASSWORD=
HH_DB_NAME=babystore
HH_DB_CONNECT_TIMEOUT=5

# ── Auth / JWT ──────────────────────────────────────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# ── Admin account ───────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Email (Gmail SMTP — use a 16-char Google "App Password") ────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=Happy Hands PH <noreply@example.com>

# ── Pagination (optional) ───────────────────────────────────────────────────
HH_CATEGORY_PAGE_SIZE=12
HH_CATEGORY_PAGE_MAX=60

# ── Danger zone (only when wiping prod data) ────────────────────────────────
HH_API_ONLY=0
HH_API_ONLY_CONFIRM=
